# Copy this file to .env for local `netlify dev` usage.
# In production, set these in Netlify Site settings > Environment variables.
# Never commit real credentials.

APP_USER_1_USERNAME=owner1
APP_USER_1_PASSWORD=change-me-1
APP_USER_2_USERNAME=owner2
APP_USER_2_PASSWORD=change-me-2

# Long random string used to sign session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
